{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adaptive-prompt-graph.dev/schema/1/transcript.schema.json",
  "title": "APG transcript: a durably stored conversation (raw-episode source for harvest and replay)",
  "$defs": {
    "TranscriptTurn": {
      "type": "object",
      "required": ["role", "content"],
      "properties": {
        "role": { "enum": ["user", "assistant"] },
        "content": { "type": "string" },
        "at": { "type": "string" },
        "meta": { "type": "object", "description": "Open bag for app extras (tool calls, routing badges)." }
      },
      "additionalProperties": false
    },
    "Transcript": {
      "type": "object",
      "required": ["id", "turns"],
      "properties": {
        "id": { "type": "string" },
        "graphId": { "type": "string" },
        "agentId": { "type": "string" },
        "title": { "type": "string" },
        "createdAt": { "type": "string" },
        "turns": { "type": "array", "items": { "$ref": "#/$defs/TranscriptTurn" } },
        "harvestedUpTo": {
          "type": "integer",
          "minimum": 0,
          "description": "Turns below this index have been distilled by wake-path harvest."
        },
        "replayedUpTo": {
          "type": "integer",
          "minimum": 0,
          "description": "Turns below this index have been re-processed by replay."
        },
        "ended": { "type": "boolean" }
      },
      "additionalProperties": false
    }
  }
}
