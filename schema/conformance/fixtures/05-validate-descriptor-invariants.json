{
  "schemaVersion": "1.0",
  "description": "Routable nodes need text in the effective descriptor; props may not contain reserved keys",
  "graph": {
    "schemaVersion": "1.0",
    "graphId": "faq",
    "profile": "L1",
    "defaults": {
      "routing": {
        "descriptor": [
          "props.question"
        ]
      }
    },
    "nodes": [
      {
        "id": "root",
        "parentId": null,
        "title": "FAQ",
        "description": "faq root",
        "routable": false
      },
      {
        "id": "faq1",
        "parentId": "root",
        "props": {
          "question": "How do I reset my password?"
        }
      },
      {
        "id": "faq2",
        "parentId": "root",
        "title": "Orphaned title"
      },
      {
        "id": "faq3",
        "parentId": "root",
        "props": {
          "question": "How do I close my account?",
          "id": "oops"
        }
      }
    ]
  },
  "op": {
    "kind": "validate"
  },
  "expected": {
    "valid": false,
    "errors": [
      {
        "code": "DESCRIPTOR_EMPTY",
        "nodeId": "faq2"
      },
      {
        "code": "RESERVED_PROPS_KEY",
        "nodeId": "faq3"
      }
    ]
  }
}
