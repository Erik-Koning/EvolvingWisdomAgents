{
  "name": "@apgraph/mcp-server",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "MCP facade over the Adaptive Prompt Graph kernel: route_query, apg_* navigation tools, tree/node resources, and routable nodes as MCP Prompts.",
  "type": "module",
  "bin": {
    "apg-mcp-server": "./dist/main.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@apgraph/connectors": "workspace:*",
    "@apgraph/core": "workspace:*",
    "@apgraph/memory": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
