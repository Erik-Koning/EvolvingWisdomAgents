{
  "name": "@apgraph/schema",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "Adaptive Prompt Graph (APG) — TypeScript types and document validators projected from the language-neutral JSON Schema in /schema.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "schemas"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node ./scripts/copy-schemas.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "ajv": "^8.17.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
